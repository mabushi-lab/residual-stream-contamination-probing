    given-names: Florian
    email: braunf25@proton.me
    # orcid: "https://orcid.org/0000-0000-0000-0000"

version: 1.0.0
date-released: 2026-08-09

repository-code: "https://github.com/mabushi-lab/residual-stream-contamination-probing"

